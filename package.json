{
  "name": "civilised-behaviour",
  "private": true,
  "version": "0.0.1",
  "description": "Civilised Behaviour (working title) - 1-4 player co-op satirical expedition sandbox",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @cb/server --filter @cb/client dev",
    "dev:server": "pnpm --filter @cb/server dev",
    "dev:client": "pnpm --filter @cb/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
